ro.vendor.soc.manufacturer=Mediatek
ro.vendor.soc.model=MT8768WT
security.securehw.available=false
security.securenvm.available=false

# Sensors
ro.vendor.mtk.sensor.support=yes

# TEE
ro.hardware.keystore=mdfpp
ro.hardware.keystore_desede=true
ro.hardware.kmsetkey=trustonic
ro.mtk_key_manager_support=1
ro.security.vpnpp.release=1.0
ro.security.vpnpp.ver=2.4
ro.vendor.mtk_sec_video_path_support=1
ro.vendor.mtk_tee_gp_support=1
